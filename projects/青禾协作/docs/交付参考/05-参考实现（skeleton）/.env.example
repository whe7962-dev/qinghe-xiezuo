# 复制为 .env 后填入真实密钥。程序只读 .env。页面不展示密钥。

# 模型服务（Anthropic-compatible 网关，服务地址/模型名/密钥都由运行配置注入）
# 本项目选定：DeepSeek V4 Pro（思考型模型）
ANTHROPIC_API_KEY=你的-key
MODEL_ID=deepseek-v4-pro
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 其他可选模型（按需切换，改上面三行即可）：
#  - DeepSeek 非思考型：MODEL_ID=deepseek-chat
#  - 智谱 GLM：        ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic  MODEL_ID=glm-5.2
#  - Kimi：            ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic       MODEL_ID=kimi-k2.7-code

# 模型单次输出上限（思考型模型的思考 token 也计入；不足时会自动加倍重试一次）
MAX_OUTPUT_TOKENS=16000
