# 复制为 .env 后填入真实密钥。程序只读 .env，页面与日志不展示密钥。
# .env 已被 .gitignore 忽略，不会被提交进仓库。

# 模型服务（Anthropic-compatible 网关，服务地址 / 模型名 / 密钥都由运行配置注入）
ANTHROPIC_API_KEY=你的-key
MODEL_ID=deepseek-chat
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 模型单次输出上限（思考型模型的思考 token 也计入；不足时会自动加倍重试一次）
MAX_OUTPUT_TOKENS=16000
# 单次模型调用超时（秒）；整批分析受 3 分钟硬上限约束
MODEL_TIMEOUT_SECONDS=170
